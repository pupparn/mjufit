# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only (app server + seed script). Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Seeded as super_admin by `npm run seed`
SUPER_ADMIN_EMAIL=you@gmail.com

# Payment: PromptPay receiver (phone number or national ID).
# Slip2Go checks every slip was paid to this PromptPay account.
PROMPTPAY_ID=0812345678

# Slip verification: "slip2go" (real) or "mock" (demo deploys — pick the result yourself)
SLIP_VERIFIER=mock
# Slip2Go dashboard (app.slip2go.com) → API Connect → Secret Key. Endpoint: /api/verify-slip/qr-image/info
SLIP2GO_API_URL=https://connect.slip2go.com
SLIP2GO_SECRET_KEY=

# Dev only (npm run dev): 1 = ignore open/close/sales-cutoff times on every device. Restart dev server after changing.
# DEV_IGNORE_HOURS=1
